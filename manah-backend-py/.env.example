PORT=3001
NODE_ENV=development

# ── Supabase ───────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# JWT Secret (only if your project uses legacy HS256 tokens)
# Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Service Role Key — used by the backend to read/write Supabase tables server-side.
# Dashboard → Project Settings → API → service_role key (keep SECRET, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── OpenRouter (LLM proxy — keys never reach the browser) ─────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=ChatBot Platform

# ── Qubrid (fallback if OpenRouter key is empty) ──────────────────────────────
QUBRID_API_KEY=your_qubrid_api_key_here
QUBRID_BASE_URL=https://platform.qubrid.com/v1
QUBRID_MODEL=google/gemini-2.5-flash

# true = mock LLM responses (for local dev/testing without API keys)
USE_MOCK_LLM=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# The frontend origin. Defaults: localhost:5173, localhost:8080.
FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173,https://myapp.vercel.app
